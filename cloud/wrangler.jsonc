{
  "name": "questbound-fc-cloud",
  "main": "worker.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "AccountCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AccountCoordinator"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "../dist/cloud-client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "account_id": "<your-cloudflare-account-id>",
  "vars": {
    "PUBLIC_ORIGIN": "https://questbound-fc-cloud.questbound-gaoryan680.workers.dev"
  }
}
