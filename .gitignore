# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Python verification artifacts
__pycache__/
*.pyc

# Generated QA renders remain local; retain source, licences and numeric validation reports.
/assets-source/player-v2/qa*/*.png
/assets-source/player-v2/qa*/*.jpg
/assets-source/player-v2/qa*/*.jpeg

# Nested standalone Cloudflare runtime/build scratch
**/.wrangler/
/cloud/work/

# Private deployment metadata (kept locally for the hosted build)
/.openai/
/.sites-runtime/
/cloud/wrangler.local.jsonc

# Local QA artefacts and generated captures
/work/

# Large authoring sources (runtime assets live in /public)
/assets-source/
/background/wrangler.local.jsonc
/PLAN-STATUS.md
dist-demo
