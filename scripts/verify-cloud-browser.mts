/** Real isolated Chrome contexts; synthetic API, not live Microsoft/OneDrive. */
import fs from 'node:fs/promises';
import assert from 'node:assert/strict';
import {OneDriveSnapshotStore} from '../lib/onedrive-storage.ts';
import {initialState} from '../lib/model.ts';
import {reduceCommand} from '../lib/domain.ts';
const origin='http://127.0.0.1:8792',account='browser-qa-only';
const objects=new Map<string,Uint8Array>();const store=new OneDriveSnapshotStore({async read(p){return objects.get(p)||null},async write(p,b){objects.set(p,b.slice())}});
await store.commit({accountId:account,baseRevision:0,operationId:'fixture',payload:{planner:reduceCommand(initialState(),{type:'task.add',task:{id:'shared',title:'Shared browser fixture'}})}});
let tail=Promise.resolve(),lost=false;const attempts:string[]=[];const results:Record<string,unknown>={environment:'isolated installed Mac Chrome; synthetic API; simulated phone viewport',passed:[]};
function connect(url:string){const ws=new WebSocket(url),pending=new Map<number,{resolve:(x:any)=>void;reject:(x:any)=>void}>();let n=0;const listeners=new Set<(v:any)=>void>();ws.onmessage=e=>{const v=JSON.parse(String(e.data));if(v.id){const p=pending.get(v.id);pending.delete(v.id);v.error?p?.reject(v.error):p?.resolve(v.result)}else listeners.forEach(f=>f(v))};return {ws,ready:new Promise<void>(r=>{ws.onopen=()=>r()}),send(method:string,params:Record<string,unknown>={}):Promise<any>{return new Promise((resolve,reject)=>{const id=++n;pending.set(id,{resolve,reject});ws.send(JSON.stringify({id,method,params}))})},listeners};}
const version=await(await fetch('http://127.0.0.1:9225/json/version')).json() as any,browser=connect(version.webSocketDebuggerUrl);await browser.ready;
const contexts:string[]=[],clients:any[]=[];
async function device(mobile=false){const {browserContextId}=await browser.send('Target.createBrowserContext');contexts.push(browserContextId);const {targetId}=await browser.send('Target.createTarget',{url:'about:blank',browserContextId});const c={...connect('ws://127.0.0.1:9225/devtools/page/'+targetId),offline:false,loseNext:false};await c.ready;clients.push(c);
 c.listeners.add((event:any)=>{if(event.method!=='Fetch.requestPaused')return;const p=event.params,path=new URL(p.request.url).pathname;tail=tail.then(async()=>{try{if(c.offline){await c.send('Fetch.failRequest',{requestId:p.requestId,errorReason:'InternetDisconnected'});return;}let value:any,status=200;
 if(path==='/api/account/session')value={account:{id:account,label:'Synthetic Microsoft QA'},configured:true};else if(path==='/api/cloud/read'||path==='/api/sync'){const s=await store.read(account);value={accountId:account,snapshot:s?{state:s.payload.planner}:null,revision:s?.revision||0,updatedAt:s?.updatedAt||''};}else if(path==='/api/cloud/commit'){const b=JSON.parse(p.request.postData);assert.equal(b.accountId,account);assert.equal(p.request.headers['X-QFC-Account']||p.request.headers['x-qfc-account'],account);attempts.push(b.operationId);try{const s=await store.commit({accountId:account,baseRevision:b.baseRevision,operationId:b.operationId,payload:{planner:b.snapshot.state}});value={accountId:account,snapshot:{state:s.payload.planner},revision:s.revision,updatedAt:s.updatedAt};if(c.loseNext){c.loseNext=false;lost=true;await c.send('Fetch.failRequest',{requestId:p.requestId,errorReason:'ConnectionClosed'});return;}}catch(e:any){status=e.status||500;value={error:e.message,code:e.code}}}else value={error:'Synthetic test does not implement '+path};
 await c.send('Fetch.fulfillRequest',{requestId:p.requestId,responseCode:status,responseHeaders:[{name:'Content-Type',value:'application/json'},{name:'Cache-Control',value:'no-store'}],body:Buffer.from(JSON.stringify(value)).toString('base64')});}catch(e){console.error('Interception',e)}});
 });
 await c.send('Page.enable');await c.send('Runtime.enable');await c.send('Network.enable');await c.send('Fetch.enable',{patterns:[{urlPattern:origin+'/api/*'}]});if(mobile)await c.send('Emulation.setDeviceMetricsOverride',{width:390,height:844,mobile:true,deviceScaleFactor:1});
 await c.send('Page.navigate',{url:origin+'/?view=quests'});await wait(c,"document.body.innerText.includes('Shared browser fixture')");return c;}
async function evaluate(c:any,expression:string){const r=await c.send('Runtime.evaluate',{expression,returnByValue:true,awaitPromise:true});if(r.exceptionDetails)throw new Error(JSON.stringify(r.exceptionDetails));return r.result.value;}
async function wait(c:any,expression:string,ms=15000){const until=Date.now()+ms;while(Date.now()<until){if(await evaluate(c,expression))return;await new Promise(r=>setTimeout(r,100))}throw new Error('Timeout '+expression+' BODY '+await evaluate(c,'document.body.innerText.slice(0,1800)'))}
async function refresh(c:any){await evaluate(c,"window.dispatchEvent(new Event('focus'));true");}
async function edit(c:any,oldTitle:string,title:string){await evaluate(c,`(()=>{const b=[...document.querySelectorAll('button')].find(x=>x.getAttribute('aria-label')===${JSON.stringify('Edit all details for '+oldTitle)});if(!b)throw new Error('Missing edit button');b.click();return true})()`);await wait(c,"!!document.querySelector('.composer-title input')");await evaluate(c,`(()=>{const x=document.querySelector('.composer-title input');Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(x,${JSON.stringify(title)});x.dispatchEvent(new Event('input',{bubbles:true}));return true})()`);await new Promise(r=>setTimeout(r,150));await evaluate(c,"(()=>{document.querySelector('.composer-title').closest('form').requestSubmit();return true})()");await wait(c,"!document.querySelector('.composer-title input')");}
const recordExpression=(value:string)=>"new Promise(resolve=>{const q=indexedDB.open('questbound-planner',1);q.onsuccess=()=>{const db=q.result,r=db.transaction('accounts').objectStore('accounts').get('browser-qa-only');r.onsuccess=()=>{resolve("+value+");db.close()}}})";
const settled="new Promise(resolve=>{const q=indexedDB.open('questbound-planner',1);q.onsuccess=()=>{const db=q.result,r=db.transaction('accounts').objectStore('accounts').get('browser-qa-only');r.onsuccess=()=>{resolve(r.result?.pending.length===0&&!r.result?.attempt);db.close()}}})";
const pass=(label:string)=>{(results.passed as string[]).push(label);console.log('PASS '+label)};
try{
 const a=await device(),b=await device(true);pass('two isolated browser contexts load the same account snapshot');
 a.loseNext=true;await edit(a,'Shared browser fixture','Browser synced edit');await wait(a,"document.body.innerText.includes('Browser synced edit')");await new Promise(r=>setTimeout(r,500));assert.equal(lost,true);await refresh(a);await wait(a,settled);assert.equal(attempts.at(-1),attempts.at(-2));pass('lost response after cloud commit retries the identical operation ID');
 await refresh(b);await wait(b,"document.body.innerText.includes('Browser synced edit')");pass('second simulated phone receives the first device edit');
 b.offline=true;await b.send('Network.emulateNetworkConditions',{offline:true,latency:0,downloadThroughput:0,uploadThroughput:0});await edit(b,'Browser synced edit','Offline phone edit');await wait(b,"document.body.innerText.includes('Offline phone edit')");await evaluate(b,"(async()=>{await navigator.serviceWorker.ready;return true})()");await b.send('Page.reload',{ignoreCache:false});await wait(b,"document.body.innerText.includes('Offline phone edit')");pass('offline phone edit survives real browser reload');
 b.offline=false;await b.send('Network.emulateNetworkConditions',{offline:false,latency:0,downloadThroughput:-1,uploadThroughput:-1});await refresh(b);await wait(b,settled);await refresh(a);await wait(a,"document.body.innerText.includes('Offline phone edit')");pass('reconnected phone uploads and desktop converges');
 b.offline=true;await b.send('Network.emulateNetworkConditions',{offline:true,latency:0,downloadThroughput:0,uploadThroughput:0});await edit(b,'Offline phone edit','Phone conflict branch');await edit(a,'Offline phone edit','Desktop conflict choice');await wait(a,settled);
 b.offline=false;await b.send('Network.emulateNetworkConditions',{offline:false,latency:0,downloadThroughput:-1,uploadThroughput:-1});await refresh(b);
 await wait(b,recordExpression('r.result?.conflicts.length>0'));
 await evaluate(b,"(()=>{document.querySelector('.header-controls>button:last-child').click();return true})()");await wait(b,"!!document.querySelector('.account-conflicts')");
 await evaluate(b,"(()=>{for(const f of document.querySelectorAll('.account-conflicts fieldset'))f.querySelectorAll('input[type=radio]')[1].click();return true})()");await evaluate(b,"(()=>{document.querySelector('.account-conflicts button').click();return true})()");await wait(b,settled);await wait(b,recordExpression("r.result?.envelope.state.tasks[0].title==='Desktop conflict choice'&&!r.result.conflicts.length"));pass('same-field conflict preserves both choices and visible selection resolves to OneDrive');
 await a.send('Page.navigate',{url:origin+'/?view=training'});await wait(a,"[...document.querySelectorAll('button')].some(x=>x.innerText==='Start focus')");await evaluate(a,"(()=>{[...document.querySelectorAll('button')].find(x=>x.innerText==='Start focus').click();return true})()");await wait(a,recordExpression('!!r.result?.envelope.state.activeSession'));await evaluate(a,"(()=>{[...document.querySelectorAll('button')].find(x=>x.innerText.trim()==='Pause').click();return true})()");await wait(a,recordExpression('!!r.result?.envelope.state.activeSession?.pausedAt'));
 const before=await evaluate(a,recordExpression('r.result.envelope.state.activeSession'));await evaluate(a,"(()=>{document.querySelector('button[lang=\"zh-CN\"]').click();return true})()");await wait(a,"document.documentElement.lang==='zh-CN'");await evaluate(a,"(()=>{document.querySelector('.theme-picker summary').click();document.querySelectorAll('.theme-popover button')[1].click();return true})()");await wait(a,"document.documentElement.dataset.theme!=='night-stadium'");await wait(a,settled);await a.send('Page.reload');await wait(a,"document.documentElement.lang==='zh-CN'&&document.documentElement.dataset.theme!=='night-stadium'");const after=await evaluate(a,recordExpression('r.result.envelope.state.activeSession'));assert.deepEqual(after,before);pass('active paused focus retains exact session through theme/language switch and reload');
 await evaluate(a,"(()=>{document.querySelector('.header-controls>button:last-child').click();return true})()");await wait(a,"!!document.querySelector('.appearance-settings input[type=checkbox]')");await evaluate(a,"(()=>{document.querySelector('.appearance-settings input[type=checkbox]').click();return true})()");await wait(a,"document.documentElement.dataset.motion==='reduce'");assert.deepEqual(await evaluate(a,recordExpression('r.result.envelope.state.activeSession')),before);pass('reduced-motion preference applies without resetting focus');await wait(a,settled);
 const final=await store.read(account);assert.equal(final!.payload.planner.tasks.length,1);assert.equal(final!.payload.planner.tasks[0].title,'Desktop conflict choice');assert.equal(final!.payload.planner.rewards.length,0);results.taskCount=1;results.commitAttempts=attempts.length;results.status='passed';
}catch(error){results.status='failed';results.error=error instanceof Error?error.message:String(error);process.exitCode=1;}finally{await fs.mkdir('work',{recursive:true});await fs.writeFile('work/cloud-browser-verification.json',JSON.stringify(results,null,2));for(const c of clients)c.ws.close();for(const id of contexts)await browser.send('Target.disposeBrowserContext',{browserContextId:id});browser.ws.close();console.log(JSON.stringify(results));}
